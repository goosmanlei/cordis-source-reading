{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cordis 2001 · 01 · Context 与函数插件",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/examples/01-function-plugin.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "smartStep": false,
      "env": {
        "TSX_DISABLE_CACHE": "1"
      },
      "pauseForSourceMap": true
    },
    {
      "name": "Cordis 2001 · 02 · 插件登记与两次独立装载",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/examples/02-plugin-and-fiber.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "smartStep": false,
      "env": {
        "TSX_DISABLE_CACHE": "1"
      },
      "pauseForSourceMap": true
    },
    {
      "name": "Cordis 2001 · 03 · 等待异步插件完成",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/examples/03-await-plugin.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "smartStep": false,
      "env": {
        "TSX_DISABLE_CACHE": "1"
      },
      "pauseForSourceMap": true
    }
  ]
}
