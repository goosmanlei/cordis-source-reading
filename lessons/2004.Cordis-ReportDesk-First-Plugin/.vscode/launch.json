{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cordis 2004 · 01 · ReportDesk",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/examples/01-reportdesk/main.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "args": [
        "--with-excerpt"
      ],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "smartStep": false,
      "env": {
        "TSX_DISABLE_CACHE": "1"
      }
    },
    {
      "name": "Cordis 2004 · 01 · 建设起点",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/examples/01-reportdesk/start.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "smartStep": false,
      "env": {
        "TSX_DISABLE_CACHE": "1"
      }
    }
  ]
}
