      "request": "launch",
      "program": "${workspaceFolder}/scripts/lesson.mjs",
      "cwd": "${workspaceFolder}",
      "args": [
        "--effect"
      ],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "smartStep": false,
      "env": {
        "TSX_DISABLE_CACHE": "1"
      },
      "pauseForSourceMap": true
    }
  ]
